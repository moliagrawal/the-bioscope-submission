# x402 facilitator URL (use x402.org testnet for Base Sepolia)
FACILITATOR_URL=https://x402.org/facilitator

# Private key for the payout wallet (receives USDC payments)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Wallet address that receives payments
PAY_TO_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# Base Sepolia network identifier
NETWORK=eip155:84532

# Session cookie signing secret
SESSION_SECRET=your-random-session-secret-here

# App origin for SIWx
NEXT_PUBLIC_APP_URL=http://localhost:3000
